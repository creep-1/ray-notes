---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';
import { SITE, TAGS } from '../consts';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const published = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = published.slice(0, 5);
const counts = Object.fromEntries(
  TAGS.map((tag) => [tag.slug, published.filter((p) => p.data.tags.includes(tag.slug)).length])
);
---

<BaseLayout>
  <div class="container home">
    <section class="hero">
      <h1>{SITE.TITLE}</h1>
      <p class="tagline">{SITE.TAGLINE}</p>
    </section>

    <section class="angles">
      <h2>四个观察角度</h2>
      <ul>
        {TAGS.map((tag) => (
          <li>
            <a class="angle" href={`${base}tags/${tag.slug}/`}>
              <span class="angle-head">
                <span class="dot" style={`background: var(--tag-${tag.slug});`} aria-hidden="true"></span>
                <span class="angle-name">{tag.name}</span>
              </span>
              <span class="angle-desc">{tag.description}</span>
              <span class="angle-count">{counts[tag.slug]} 篇</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="latest">
      <h2>最新切片</h2>
      <div class="cards">
        {latest.map((entry) => <EssayCard entry={entry} />)}
        {latest.length === 0 && <p class="empty">还没有随笔。</p>}
      </div>
      <a class="all-link" href={`${base}essays/`}>查看全部随笔 →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-12) var(--space-16);
  }

  .tagline {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-md);
  }

  .angles {
    margin-top: var(--space-12);
  }

  .angles ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }

  .angles li + li {
    border-top: 1px solid var(--border);
  }

  .angle {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .angle:hover .angle-name {
    color: var(--accent);
  }

  .angle-head {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: 50%;
  }

  .angle-name {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .angle-desc {
    flex: 1;
    min-width: 12rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .angle-count {
    color: var(--text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .latest {
    margin-top: var(--space-12);
  }

  .cards {
    margin-top: var(--space-4);
  }

  .empty {
    color: var(--text-muted);
  }

  .all-link {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }
</style>
