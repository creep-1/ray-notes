---
import type { CollectionEntry } from 'astro:content';
import PlaceholderBadge from './PlaceholderBadge.astro';
import TagPill from './TagPill.astro';

interface Props {
  entry: CollectionEntry<'essays'>;
}

const { entry } = Astro.props;
const { title, date, tags, summary, spoiler, placeholder } = entry.data;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const dateText = date.toISOString().slice(0, 10);
const href = `${base}essays/${entry.id}/`;
---

<article class="essay-card">
  <p class="meta">
    <time datetime={dateText}>{dateText}</time>
    {spoiler && <span class="spoiler-hint" title="本文含剧透">🚧</span>}
    {placeholder && <PlaceholderBadge />}
  </p>
  <h2 class="title"><a href={href}>{title}</a></h2>
  <p class="tags">
    {tags.map((slug) => <TagPill slug={slug} />)}
  </p>
  <p class="summary">{summary}</p>
</article>

<style>
  .essay-card {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .essay-card:last-child {
    border-bottom: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: none;
  }

  .title {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
  }

  .title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title a:hover {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    max-width: none;
  }

  .summary {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .spoiler-hint {
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
