---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} {SITE.TITLE}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
